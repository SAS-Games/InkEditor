{
  "name": "inky",
  "productName": "Inky",
  "version": "0.15.2",
  "description": "An editor for ink",
  "main": "main-process/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkle/inky.git"
  },
  "scripts": {
    "postinstall": "install-electron && node ../build/createDocumentnavigation.js && node ../build/generateEmbeddedDocumentation.mjs",
    "start": "electron main-process/main.js",
    "test": "mocha \"test/**/*.unit.test.js\"",
    "test:e2e": "mocha test/test.js",
    "generate-locale": "node ../build/generateLocale.js",
    "build-package": "node build-package.js"
  },
  "keywords": [
    "ink",
    "narrative",
    "editor"
  ],
  "author": "inkle Ltd",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "bugs": {
    "url": "https://github.com/inkly/inky/issues"
  },
  "homepage": "http://www.inklestudios.com/ink",
  "dependencies": {
    "chokidar": "^3.6.0",
    "fuzzaldrin-plus": "^0.6.0",
    "inkjs": "^2.4.0",
    "lodash": "^4.18.1",
    "mkdirp": "^3.0.1",
    "randomstring": "^1.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "chai": "^5.3.3",
    "chai-as-promised": "^7.1.2",
    "electron": "^44.4.5",
    "jsdom": "^24.1.3",
    "marked": "^18.0.14",
    "mocha": "^12.0.2"
  }
}
